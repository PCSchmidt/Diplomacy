# Copy to `.env` in this same directory (the repo root) and fill in.
# `.env` is gitignored; `.env.example` is committed and must never hold a real key.
#
# Only set what you need — the mock provider requires neither, and the whole
# test suite runs without any credential at all.

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-v1-...
